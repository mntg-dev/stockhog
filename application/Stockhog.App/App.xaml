<Application x:Class="Stockhog.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Stockhog.App.Views"
             xmlns:backtesting="clr-namespace:Stockhog.Presentation.Backtesting;assembly=Stockhog.Presentation"
             xmlns:marketData="clr-namespace:Stockhog.Presentation.MarketData;assembly=Stockhog.Presentation"
             xmlns:jobs="clr-namespace:Stockhog.Presentation.Jobs;assembly=Stockhog.Presentation"
             xmlns:logs="clr-namespace:Stockhog.Presentation.Logging;assembly=Stockhog.Presentation"
             xmlns:guide="clr-namespace:Stockhog.Presentation.Guide;assembly=Stockhog.Presentation"
             xmlns:compare="clr-namespace:Stockhog.Presentation.Compare;assembly=Stockhog.Presentation"
             xmlns:strategies="clr-namespace:Stockhog.Presentation.Strategies;assembly=Stockhog.Presentation"
             xmlns:assistant="clr-namespace:Stockhog.Presentation.Assistant;assembly=Stockhog.Presentation"
             xmlns:settings="clr-namespace:Stockhog.Presentation.Settings;assembly=Stockhog.Presentation"
             xmlns:optimization="clr-namespace:Stockhog.Presentation.Optimization;assembly=Stockhog.Presentation"
             xmlns:analytics="clr-namespace:Stockhog.Presentation.Analytics;assembly=Stockhog.Presentation"
             xmlns:trading="clr-namespace:Stockhog.Presentation.Trading;assembly=Stockhog.Presentation">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- View-model-first navigation: the shell shows a page view model, WPF picks its view here. -->
            <DataTemplate DataType="{x:Type backtesting:BacktestViewModel}"><views:BacktestView /></DataTemplate>
            <DataTemplate DataType="{x:Type strategies:StrategiesViewModel}"><views:StrategiesView /></DataTemplate>
            <DataTemplate DataType="{x:Type backtesting:HistoryViewModel}"><views:HistoryView /></DataTemplate>
            <DataTemplate DataType="{x:Type compare:CompareViewModel}"><views:CompareView /></DataTemplate>
            <DataTemplate DataType="{x:Type assistant:AssistantViewModel}"><views:AssistantView /></DataTemplate>
            <DataTemplate DataType="{x:Type optimization:OptimizationViewModel}"><views:OptimizationView /></DataTemplate>
            <DataTemplate DataType="{x:Type analytics:AnalysisViewModel}"><views:AnalysisView /></DataTemplate>
            <DataTemplate DataType="{x:Type trading:TradingViewModel}"><views:TradingView /></DataTemplate>
            <DataTemplate DataType="{x:Type marketData:MarketDataViewModel}"><views:MarketDataView /></DataTemplate>
            <DataTemplate DataType="{x:Type jobs:JobsViewModel}"><views:JobsView /></DataTemplate>
            <DataTemplate DataType="{x:Type logs:LogsViewModel}"><views:LogsView /></DataTemplate>
            <DataTemplate DataType="{x:Type guide:GuideViewModel}"><views:GuideView /></DataTemplate>
            <DataTemplate DataType="{x:Type settings:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
