<Window x:Class="Stockhog.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Stockhog.Presentation.Localization;assembly=Stockhog.Presentation"
        Title="{Binding Title}" Language="{Binding Language}"
        Height="860" Width="1360" MinHeight="600" MinWidth="1000"
        Background="{StaticResource PageBackground}">

    <!-- Shell: sidebar navigation, the current page (rendered via DataTemplates in App.xaml) and a shared status bar. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <TextBlock DockPanel.Dock="Top" Text="Stockhog" Foreground="White" FontSize="20" FontWeight="Bold" Margin="20,16,0,10" />
            <ListBox ItemsSource="{Binding PagesView}" SelectedItem="{Binding SelectedItem}"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <!-- The pages without a section (Home) get no header. -->
                                <TextBlock Foreground="#8B95A5" FontSize="11" FontWeight="SemiBold" Margin="22,10,0,2">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizeKey}">
                                            <Binding Path="Name" />
                                            <Binding Path="Culture" Source="{x:Static loc:Loc.Instance}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Name}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center" />
                            <TextBlock FontSize="14" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource LocalizeKey}">
                                        <Binding Path="TitleKey" />
                                        <Binding Path="Culture" Source="{x:Static loc:Loc.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Row="0" Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="#FFF4E5" BorderBrush="#F0C48A" BorderThickness="0,0,0,1" Padding="16,8"
                    Visibility="{Binding Update.IsVisible, Converter={StaticResource BooleanToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{loc:Tr Update_Dismiss}" Command="{Binding Update.DismissCommand}" Margin="6,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="{loc:Tr Update_Download}" Command="{Binding Update.DownloadCommand}"
                            Style="{StaticResource PrimaryButton}" />
                    <TextBlock Text="{Binding Update.Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
            <ContentControl Content="{Binding CurrentPage}" Margin="16" Focusable="False" />
        </DockPanel>

        <StatusBar Grid.Row="1" Grid.ColumnSpan="2" Padding="8,2">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0" HorizontalContentAlignment="Stretch">
                <ProgressBar Value="{Binding Status.Progress, Mode=OneWay}" Height="14"
                             Visibility="{Binding Status.IsBusy, Converter={StaticResource BooleanToVisibility}}" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <TextBlock Text="{Binding Status.Message}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Tr Shell_ActiveJobs}" Foreground="Gray" />
                    <TextBlock Text="{Binding Jobs.ActiveCount}" FontWeight="Bold" Margin="4,0,0,0" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
