<UserControl x:Class="Stockhog.App.Views.ScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Stockhog.Presentation.Localization;assembly=Stockhog.Presentation"
             xmlns:controls="clr-namespace:Stockhog.Wpf.Controls;assembly=Stockhog.Wpf.Controls"
             xmlns:scanning="clr-namespace:Stockhog.Presentation.Scanning;assembly=Stockhog.Presentation">
    <UserControl.Resources>
        <scanning:ScanRejectionConverter x:Key="RejectionText" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- What to scan -->
        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
            <ScrollViewer Style="{StaticResource FormScrollViewer}">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Scanner_Title}" Style="{StaticResource PageTitle}" />

                    <TextBlock Text="{loc:Tr Field_SymbolList}" Style="{StaticResource FieldLabel}" />
                    <controls:SymbolBox Text="{Binding SymbolList}" AllowMultiple="True"
                                        SuggestionProvider="{StaticResource SymbolSuggestions}" ToolTip="{loc:Tr Scanner_SymbolsHint}"
                                        AutomationProperties.Name="{loc:Tr Field_SymbolList}" />
                    <Button Content="{loc:Tr Scanner_UseScreener}" Command="{Binding UseScreenerResultCommand}" Margin="0,6,0,0" />

                    <TextBlock Text="{loc:Tr Scanner_Strategies}" Style="{StaticResource FieldLabel}" />
                    <ItemsControl ItemsSource="{Binding Strategies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2"
                                          ToolTip="{Binding Strategy, Converter={StaticResource StrategyText}, ConverterParameter=Description}">
                                    <TextBlock Text="{Binding Strategy, Converter={StaticResource StrategyText}}" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,3,0">
                            <TextBlock Text="{loc:Tr Field_StartDate}" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding StartDate}" />
                        </StackPanel>
                        <StackPanel Margin="3,0,0,0">
                            <TextBlock Text="{loc:Tr Field_EndDate}" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding EndDate}" />
                        </StackPanel>
                    </UniformGrid>

                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,3,0">
                            <TextBlock Text="{loc:Tr Field_InitialCapital}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding InitialCapital, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="3,0,0,0">
                            <TextBlock Text="{loc:Tr Scanner_Parallel}" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{loc:Tr Scanner_ParallelHint}" />
                            <ComboBox ItemsSource="{Binding ParallelOptions}" SelectedItem="{Binding MaxParallel}" ToolTip="{loc:Tr Scanner_ParallelHint}" />
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="{loc:Tr Scanner_Checks}" Style="{StaticResource SectionTitle}" Margin="0,14,0,0" />
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,3,0">
                            <TextBlock Text="{loc:Tr Scanner_MinTrades}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MinTrades, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="3,0,0,0">
                            <TextBlock Text="{loc:Tr Scanner_MaxDrawdown}" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{loc:Tr Scanner_MaxDrawdownHint}" />
                            <TextBox Text="{Binding MaxDrawdownPercent, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Tr Scanner_MaxDrawdownHint}" />
                        </StackPanel>
                    </UniformGrid>
                    <CheckBox Content="{loc:Tr Scanner_BothHalves}" IsChecked="{Binding RequireBothHalvesProfitable}"
                              ToolTip="{loc:Tr Scanner_BothHalvesHint}" Margin="0,10,0,0" />

                    <Button Content="{loc:Tr Scanner_Start}" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" />
                    <TextBlock Text="{loc:Tr Scanner_StartHint}" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Results -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <WrapPanel Margin="0,0,0,6">
                <TextBlock Text="{loc:Tr Scanner_Results}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <ComboBox ItemsSource="{Binding Scans}" SelectedItem="{Binding SelectedScan}" MinWidth="300" VerticalAlignment="Center" Margin="0,0,12,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding CreatedAt.LocalDateTime, StringFormat=g, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding Symbols, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding Strategies, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding Status, Converter={StaticResource LocalizedEnum}, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding Summary}" Foreground="Gray" VerticalAlignment="Center" />
            </WrapPanel>

            <StackPanel Grid.Row="1" Style="{StaticResource Toolbar}">
                <Button Content="{loc:Tr Common_Refresh}" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                <Button Content="{loc:Tr History_Open}" Command="{Binding OpenSelectedCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=CandidatesGrid}" Margin="0,0,6,0" />
                <Button Content="{loc:Tr Scanner_CheckSignals}" Command="{Binding CheckSignalsCommand}" ToolTip="{loc:Tr Scanner_CheckSignalsHint}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
                <Button Content="{loc:Tr Scanner_Stop}" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" Margin="0,0,12,0" />
                <CheckBox Content="{loc:Tr Scanner_OnlyPassed}" IsChecked="{Binding OnlyPassed}" VerticalAlignment="Center" />
            </StackPanel>

            <Grid Grid.Row="2">
                <DataGrid x:Name="CandidatesGrid" ItemsSource="{Binding Candidates}" SelectionMode="Extended">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenSelectedCommand}"
                                      CommandParameter="{Binding SelectedItems, ElementName=CandidatesGrid}" />
                    </DataGrid.InputBindings>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Passed}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="{loc:Tr Scanner_Passed}" Binding="{Binding Passed, Mode=OneWay}" Width="60" MinWidth="60" />
                        <DataGridTextColumn Header="{loc:Tr Field_Symbol}" Binding="{Binding Symbol}" Width="70" MinWidth="70" />
                        <DataGridTextColumn Header="{loc:Tr Field_Strategy}" Binding="{Binding StrategyName, Converter={StaticResource StrategyText}}" Width="170" MinWidth="170" />
                        <DataGridTextColumn Header="{loc:Tr Scanner_Signal}" Binding="{Binding Signal.Kind, Converter={StaticResource LocalizedEnum}}" Width="Auto" MinWidth="80" />
                        <DataGridTextColumn Header="{loc:Tr Scanner_SignalSince}" Binding="{Binding Signal.EntryTime, StringFormat=d}" Width="Auto" MinWidth="80" />
                        <DataGridTextColumn Header="{loc:Tr Scanner_LastPrice}" Binding="{Binding Signal.LastPrice, StringFormat=N2}" Width="Auto" MinWidth="65" />
                        <DataGridTextColumn Header="{loc:Tr Scanner_StopPrice}" Binding="{Binding Signal.StopPrice, StringFormat=N2}" Width="Auto" MinWidth="55" />
                        <DataGridTextColumn Header="{loc:Tr Scanner_Score}" Binding="{Binding Score, StringFormat=N2}" Width="Auto" MinWidth="55" />
                        <DataGridTextColumn Header="{loc:Tr Compare_NetProfit}" Binding="{Binding NetProfitPercent, StringFormat=N2}" Width="Auto" MinWidth="60" />
                        <DataGridTextColumn Header="{loc:Tr Scanner_FirstHalf}" Binding="{Binding FirstHalfReturnPercent, StringFormat=N2}" Width="Auto" MinWidth="55" />
                        <DataGridTextColumn Header="{loc:Tr Scanner_SecondHalf}" Binding="{Binding SecondHalfReturnPercent, StringFormat=N2}" Width="Auto" MinWidth="55" />
                        <DataGridTextColumn Header="{loc:Tr Compare_MaxDrawdown}" Binding="{Binding MaxDrawdownPercent, StringFormat=N2}" Width="Auto" MinWidth="60" />
                        <DataGridTextColumn Header="{loc:Tr Scanner_MonteCarloDrawdown}" Binding="{Binding MonteCarloDrawdownPercent, StringFormat=N2}" Width="Auto" MinWidth="60" />
                        <DataGridTextColumn Header="{loc:Tr Scanner_BuyAndHold}" Binding="{Binding BuyAndHoldReturnPercent, StringFormat=N2}" Width="Auto" MinWidth="60" />
                        <DataGridTextColumn Header="{loc:Tr Kpi_Trades}" Binding="{Binding TotalTrades}" Width="Auto" MinWidth="50" />
                        <DataGridTextColumn Header="{loc:Tr Kpi_Sharpe}" Binding="{Binding SharpeRatio, StringFormat=N2}" Width="Auto" MinWidth="50" />
                        <DataGridTextColumn Header="{loc:Tr Scanner_Why}" Binding="{Binding Rejections, Converter={StaticResource RejectionText}}" Width="Auto" MinWidth="200" />
                        <DataGridTextColumn Header="{loc:Tr History_Status}" Binding="{Binding Status, Converter={StaticResource LocalizedEnum}}" Width="85" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{loc:Tr Scanner_Empty}" TextWrapping="Wrap" Foreground="Gray" Margin="16,48,16,0" HorizontalAlignment="Center"
                           TextAlignment="Center" MaxWidth="460" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCandidates}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
