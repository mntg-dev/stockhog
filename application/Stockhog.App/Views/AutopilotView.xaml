<UserControl x:Class="Stockhog.App.Views.AutopilotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Stockhog.Presentation.Localization;assembly=Stockhog.Presentation">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Tr Autopilot_Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="1" Text="{loc:Tr Autopilot_Intro}" TextWrapping="Wrap" Foreground="Gray" MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,0,10" />

        <StackPanel Grid.Row="2" Style="{StaticResource Toolbar}">
            <TextBlock Text="{loc:Tr Autopilot_Mode}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <RadioButton GroupName="AutopilotMode" Content="{loc:Tr AutopilotMode_Off}" IsChecked="{Binding IsOff}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <RadioButton GroupName="AutopilotMode" Content="{loc:Tr AutopilotMode_Shadow}" IsChecked="{Binding IsShadow}" VerticalAlignment="Center" Margin="0,0,10,0"
                         ToolTip="{loc:Tr Autopilot_ShadowHint}" />
            <RadioButton GroupName="AutopilotMode" Content="{loc:Tr AutopilotMode_Paper}" IsChecked="{Binding IsPaper}" VerticalAlignment="Center" Margin="0,0,10,0"
                         ToolTip="{loc:Tr Autopilot_PaperHint}" />
            <RadioButton GroupName="AutopilotMode" Content="{loc:Tr AutopilotMode_Live}" IsEnabled="False" VerticalAlignment="Center" Margin="0,0,18,0"
                         ToolTip="{loc:Tr Autopilot_NotAvailableHint}" ToolTipService.ShowOnDisabled="True" />
            <Button Content="{loc:Tr Autopilot_RunCycle}" Command="{Binding RunCycleCommand}" Style="{StaticResource PrimaryButton}"
                    ToolTip="{loc:Tr Autopilot_RunCycleHint}" Margin="0,0,6,0" />
            <Button Content="{loc:Tr Common_Refresh}" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Style="{StaticResource Toolbar}">
            <TextBlock Text="{loc:Tr Autopilot_MaxLosses}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding MaxConsecutiveLosses, UpdateSourceTrigger=PropertyChanged}" Width="44" Margin="0,0,14,0" />
            <TextBlock Text="{loc:Tr Autopilot_MaxCapital}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding MaxCapitalPercent, UpdateSourceTrigger=PropertyChanged}" Width="54" Margin="0,0,10,0" ToolTip="{loc:Tr Autopilot_MaxCapitalHint}" />
            <Button Content="{loc:Tr Autopilot_SaveLimits}" Command="{Binding SaveLimitsCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{Binding SummaryText}" Foreground="Gray" Margin="0,0,0,6" />

        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="{loc:Tr Autopilot_Pairs}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="{loc:Tr Autopilot_ToggleEnabled}" Command="{Binding ToggleEnabledCommand}" Margin="0,0,6,0" />
                    <Button Content="{loc:Tr Autopilot_Resume}" Command="{Binding ResumeCommand}" ToolTip="{loc:Tr Autopilot_ResumeHint}" Margin="0,0,6,0" />
                    <Button Content="{loc:Tr Autopilot_Remove}" Command="{Binding RemoveCommand}" />
                </StackPanel>
            </DockPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Assignments}" SelectedItem="{Binding SelectedAssignment}" SelectionMode="Single">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter Property="Foreground" Value="Gray" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                <Setter Property="Foreground" Value="Gray" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHolding}" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="{loc:Tr Autopilot_Enabled}" Binding="{Binding Enabled, Mode=OneWay}" IsReadOnly="True" Width="Auto" MinWidth="40" />
                    <DataGridTextColumn Header="{loc:Tr Field_Symbol}" Binding="{Binding Symbol}" Width="70" MinWidth="70" />
                    <DataGridTextColumn Header="{loc:Tr Field_Strategy}" Binding="{Binding StrategyName, Converter={StaticResource StrategyText}}" Width="170" MinWidth="170" />
                    <DataGridTextColumn Header="{loc:Tr Scanner_Score}" Binding="{Binding Score, StringFormat=N2}" Width="Auto" MinWidth="55" />
                    <DataGridTextColumn Header="{loc:Tr Autopilot_PositionKind}" Binding="{Binding PositionMode, Converter={StaticResource LocalizedEnum}}" Width="Auto" MinWidth="70" />
                    <DataGridTextColumn Header="{loc:Tr Proposals_Quantity}" Binding="{Binding Quantity, StringFormat=N0}" Width="Auto" MinWidth="60" />
                    <DataGridTextColumn Header="{loc:Tr Autopilot_EntryOrder}" Binding="{Binding EntryOrderId}" Width="Auto" MinWidth="90" />
                    <DataGridTextColumn Header="{loc:Tr Autopilot_EntryPrice}" Binding="{Binding EntryPrice, StringFormat=N2}" Width="Auto" MinWidth="70" />
                    <DataGridTextColumn Header="{loc:Tr Scanner_StopPrice}" Binding="{Binding StopPrice, StringFormat=N2}" Width="Auto" MinWidth="60" />
                    <DataGridTextColumn Header="{loc:Tr Autopilot_EntryAt}" Binding="{Binding EntryAt.LocalDateTime, StringFormat=g}" Width="Auto" MinWidth="110" />
                    <DataGridTextColumn Header="{loc:Tr Autopilot_Realized}" Binding="{Binding RealizedProfit, StringFormat=N2}" Width="Auto" MinWidth="80" />
                    <DataGridTextColumn Header="{loc:Tr Autopilot_Trades}" Binding="{Binding ClosedTrades}" Width="Auto" MinWidth="50" />
                    <DataGridTextColumn Header="{loc:Tr Autopilot_WinRate}" Binding="{Binding WinRatePercent, StringFormat=N1}" Width="Auto" MinWidth="55" />
                    <DataGridTextColumn Header="{loc:Tr Autopilot_Losses}" Binding="{Binding ConsecutiveLosses}" Width="Auto" MinWidth="60" />
                    <DataGridTextColumn Header="{loc:Tr Autopilot_Paused}" Binding="{Binding PausedReason}" Width="Auto" MinWidth="160" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="1" Text="{loc:Tr Autopilot_Empty}" TextWrapping="Wrap" Foreground="Gray" Margin="16,48,16,0" HorizontalAlignment="Center"
                       TextAlignment="Center" MaxWidth="520" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAssignments}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <TextBlock Grid.Row="6" Text="{loc:Tr Autopilot_Decisions}" Style="{StaticResource SectionTitle}" Margin="0,10,0,4" />
        <DataGrid Grid.Row="7" ItemsSource="{Binding Decisions}" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Tr Autopilot_Time}" Binding="{Binding Time.LocalDateTime, StringFormat=g}" Width="Auto" MinWidth="110" />
                <DataGridTextColumn Header="{loc:Tr Autopilot_ModeColumn}" Binding="{Binding Mode, Converter={StaticResource LocalizedEnum}}" Width="Auto" MinWidth="70" />
                <DataGridTextColumn Header="{loc:Tr Field_Symbol}" Binding="{Binding Symbol}" Width="70" MinWidth="70" />
                <DataGridTextColumn Header="{loc:Tr Field_Strategy}" Binding="{Binding StrategyName, Converter={StaticResource StrategyText}}" Width="170" MinWidth="170" />
                <DataGridTextColumn Header="{loc:Tr Autopilot_Action}" Binding="{Binding Action, Converter={StaticResource LocalizedEnum}}" Width="Auto" MinWidth="70" />
                <DataGridTextColumn Header="{loc:Tr Proposals_Quantity}" Binding="{Binding Quantity, StringFormat=N0}" Width="Auto" MinWidth="60" />
                <DataGridTextColumn Header="{loc:Tr Autopilot_Price}" Binding="{Binding Price, StringFormat=N2}" Width="Auto" MinWidth="70" />
                <DataGridTextColumn Header="{loc:Tr Scanner_StopPrice}" Binding="{Binding StopPrice, StringFormat=N2}" Width="Auto" MinWidth="60" />
                <DataGridTextColumn Header="{loc:Tr Autopilot_Profit}" Binding="{Binding Profit, StringFormat=N2}" Width="Auto" MinWidth="70" />
                <DataGridTextColumn Header="{loc:Tr Proposals_Reason}" Binding="{Binding Reason}" Width="Auto" MinWidth="240" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
