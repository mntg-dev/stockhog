<UserControl x:Class="Stockhog.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Stockhog.Presentation.Localization;assembly=Stockhog.Presentation"
             xmlns:controls="clr-namespace:Stockhog.Wpf.Controls;assembly=Stockhog.Wpf.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Tr Settings_Title}" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Settings_Language}" Style="{StaticResource SectionTitle}" />
                    <ComboBox ItemsSource="{Binding Cultures}" SelectedItem="{Binding SelectedCulture}" Width="220" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NativeName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{loc:Tr Settings_LanguageHint}" Foreground="Gray" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <CheckBox Content="{loc:Tr Settings_ShowNotifications}" IsChecked="{Binding ShowNotifications}" Margin="0,12,0,0"
                              ToolTip="{loc:Tr Settings_ShowNotificationsHint}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Settings_Defaults}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{loc:Tr Field_SymbolList}" Style="{StaticResource FieldLabel}" />
                    <controls:SymbolBox Text="{Binding DefaultSymbols, ValidatesOnNotifyDataErrors=True}" AllowMultiple="True"
                                        SuggestionProvider="{StaticResource SymbolSuggestions}" ToolTip="{loc:Tr Symbol_SearchHint}"
                                        AutomationProperties.Name="{loc:Tr Field_SymbolList}" />
                    <TextBlock Text="{loc:Tr Field_InitialCapital}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding DefaultInitialCapital, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                    <TextBlock Text="{loc:Tr Settings_DefaultsHint}" Foreground="Gray" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <Button Content="{loc:Tr Common_Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Settings_Broker}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding BrokerKeyStatus}" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Tr Settings_BrokerRestart}" Foreground="{StaticResource NegativeBrush}" TextWrapping="Wrap" Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BrokerKeyRestartNeeded}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{loc:Tr Settings_BrokerApiKey}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="BrokerKeyBox" AutomationProperties.Name="{loc:Tr Settings_BrokerApiKey}" />
                    <TextBlock Text="{loc:Tr Settings_BrokerSecret}" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="BrokerSecretBox" AutomationProperties.Name="{loc:Tr Settings_BrokerSecret}" />
                    <Expander Header="{loc:Tr Settings_BrokerPaperKeys}" Margin="0,8,0,0">
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="{loc:Tr Settings_BrokerPaperKeysHint}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{loc:Tr Settings_BrokerPaperApiKey}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="PaperKeyBox" AutomationProperties.Name="{loc:Tr Settings_BrokerPaperApiKey}" />
                            <TextBlock Text="{loc:Tr Settings_BrokerPaperSecret}" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="PaperSecretBox" AutomationProperties.Name="{loc:Tr Settings_BrokerPaperSecret}" />
                        </StackPanel>
                    </Expander>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{loc:Tr Settings_BrokerTest}" Click="OnTestBrokerKeys" Margin="0,0,6,0" />
                        <Button Content="{loc:Tr Settings_BrokerSave}" Click="OnSaveBrokerKeys" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
                        <Button Content="{loc:Tr Settings_BrokerRemove}" Command="{Binding RemoveBrokerKeysCommand}" />
                    </StackPanel>
                    <TextBlock Text="{loc:Tr Settings_BrokerHint}" Foreground="Gray" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Settings_Limits}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{loc:Tr Settings_LimitsHint}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Tr Settings_MaxOrderNotional}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxOrderNotional, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{loc:Tr Settings_MaxPositionNotional}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxPositionNotional, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{loc:Tr Settings_MaxPositionPercent}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxPositionPercent, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{loc:Tr Settings_MaxDailyLoss}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxDailyLoss, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{loc:Tr Settings_MaxDrawdownPercent}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxDrawdownPercent, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Tr Settings_MaxOpenPositions}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxOpenPositions, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{loc:Tr Settings_MaxOpenOrders}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxOpenOrders, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{loc:Tr Settings_MaxOrdersPerDay}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding MaxOrdersPerDay, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="{loc:Tr Settings_FlattenOnDrawdown}" IsChecked="{Binding FlattenOnDrawdown}" Margin="0,14,0,0"
                                      ToolTip="{loc:Tr Settings_FlattenOnDrawdownHint}" />
                        </StackPanel>
                    </Grid>
                    <Button Content="{loc:Tr Settings_SaveLimits}" Command="{Binding SaveLimitsCommand}" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Settings_Assistant}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding AssistantStatus}" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:Tr Settings_ApiKey}" Style="{StaticResource FieldLabel}" />
                    <!-- A password box keeps the key off the screen; it has no bindable value, so the view hands it over. -->
                    <PasswordBox x:Name="ApiKeyBox" AutomationProperties.Name="{loc:Tr Settings_ApiKey}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{loc:Tr Settings_SaveApiKey}" Click="OnSaveApiKey" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
                        <Button Content="{loc:Tr Settings_RemoveApiKey}" Command="{Binding RemoveApiKeyCommand}" />
                    </StackPanel>
                    <TextBlock Text="{loc:Tr Settings_ApiKeyHint}" Foreground="Gray" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="{loc:Tr Settings_Environment}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Grid.Row="1" Text="{loc:Tr Settings_DataFolder}" Foreground="Gray" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Environment.DataFolder, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" />
                    <TextBlock Grid.Row="2" Text="{loc:Tr Settings_ResultsFolder}" Foreground="Gray" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Environment.ResultsFolder, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" />
                    <TextBlock Grid.Row="3" Text="{loc:Tr Settings_Database}" Foreground="Gray" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Environment.DatabaseFile, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" />
                    <TextBlock Grid.Row="4" Text="{loc:Tr Settings_LogFolder}" Foreground="Gray" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Environment.LogFolder, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" />
                    <TextBlock Grid.Row="5" Text="{loc:Tr Settings_AlpacaKeys}" Foreground="Gray" />
                    <TextBlock Grid.Row="5" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{loc:Tr Settings_AlpacaMissing}" />
                                <Setter Property="Foreground" Value="{StaticResource NegativeBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Environment.AlpacaCredentialsConfigured}" Value="True">
                                        <Setter Property="Text" Value="{loc:Tr Settings_AlpacaConfigured}" />
                                        <Setter Property="Foreground" Value="{StaticResource PositiveBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Row="6" Text="{loc:Tr Settings_ParallelJobs}" Foreground="Gray" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Environment.MaxParallelJobs}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="7" Text="{loc:Tr Settings_Version}" Foreground="Gray" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Environment.Version}" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Margin="0,10,0,0">
                        <Button Content="{loc:Tr Settings_ExportDiagnostics}" Command="{Binding ExportDiagnosticsCommand}" HorizontalAlignment="Left" />
                        <TextBlock Text="{loc:Tr Settings_ExportDiagnosticsHint}" Foreground="Gray" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
