<UserControl x:Class="Stockhog.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Stockhog.Presentation.Localization;assembly=Stockhog.Presentation"
             xmlns:trading="clr-namespace:Stockhog.Presentation.Trading;assembly=Stockhog.Presentation"
             xmlns:autopilot="clr-namespace:Stockhog.Presentation.Autopilot;assembly=Stockhog.Presentation"
             xmlns:proposals="clr-namespace:Stockhog.Presentation.Proposals;assembly=Stockhog.Presentation">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Tr Home_Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{loc:Tr Home_Intro}" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,14" />

            <!-- Overview: three cards side by side. -->
            <UniformGrid Columns="3" Margin="0,0,0,12">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="{loc:Tr Home_Open}" Command="{Binding OpenCommand}"
                                CommandParameter="{x:Type trading:TradingViewModel}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Home_Account}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding AccountText}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AccountAtLimit}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource NegativeBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="{loc:Tr Home_Open}" Command="{Binding OpenCommand}"
                                CommandParameter="{x:Type autopilot:AutopilotViewModel}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Home_AutopilotTitle}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding AutopilotText}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="{loc:Tr Home_Open}" Command="{Binding OpenCommand}"
                                CommandParameter="{x:Type proposals:ProposalsViewModel}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Home_ProposalsTitle}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding ProposalsText}" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding StepsDone}" Foreground="Gray" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Tr Home_GettingStarted}" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{loc:Tr Home_Open}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                Command="{Binding DataContext.OpenStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <!-- A tick once done, an empty circle before. -->
                                        <TextBlock DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Width="32"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xEA3A;" />
                                                    <Setter Property="Foreground" Value="#9AA3AF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Text" Value="&#xEC61;" />
                                                            <Setter Property="Foreground" Value="{StaticResource PositiveBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Hint}" Foreground="Gray" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
